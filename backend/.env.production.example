# NEXORA AI — Production Environment Variables Configuration Template
# COPY THIS FILE TO .env IN YOUR PRODUCTION BACKEND DIRECTORY AND FILL IN SECURE VALUES

# Core Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://app.nexora.ai

# Security & Tokens (Use 64-byte random string for production)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_256_BIT_SECRET_KEY
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# MySQL Database Configuration
DB_HOST=mysql.internal.nexora.ai
DB_PORT=3306
DB_USER=nexora_prod_user
DB_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD
DB_NAME=nexora_ai_production
DB_CONNECTION_LIMIT=20

# Redis Cache & BullMQ Configuration
REDIS_HOST=redis.internal.nexora.ai
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD

# External LLM / AI Services (Optional)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_OPENROUTER_KEY
